    <modelVersion>4.0.0</modelVersion>
    <groupId>com.Koovers</groupId>
    <artifactId>DemowebframeworkBDD</artifactId>
<!--    <packaging>war</packaging>-->
    <version>1.0</version>


    <properties>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <browser>CHROME</browser>

        <browserMode>headless</browserMode>

        <cucumber.filter.tags>@cart</cucumber.filter.tags>

        <cucumber.features>src/test/java/scenarios/features</cucumber.features>

        <credsFilePath>src/test/resources/Credentials.properties.txt</credsFilePath>


        <!-- Dependency versions -->
        <version.jackson-databind>2.13.4.1</version.jackson-databind>
        <version.guava>31.1-jre</version.guava>
        <version.gson>2.8.9</version.gson>
        <version.commons-io>2.11.0</version.commons-io>
        <version.cucumber-java>7.0.0</version.cucumber-java>
        <version.io.github.bonigarcia.webdrivermanager>5.8.0</version.io.github.bonigarcia.webdrivermanager>
        <version.io.rest-assured>4.4.0</version.io.rest-assured>
        <version.selenium-java>4.22.0</version.selenium-java>
        <version.maven-surefire-plugin>3.0.0-M5</version.maven-surefire-plugin>
        <version.extentreports-cucumber7-adapter>1.2.0</version.extentreports-cucumber7-adapter>
        <version.lombok>1.18.32</version.lombok>
        <version.formatter-maven-plugin>2.18.0</version.formatter-maven-plugin>
        <version.poi>5.2.2</version.poi>
        <threadCount>4</threadCount>
<!--        <sonar.host.url>http://localhost:9000</sonar.host.url>-->
<!--        <sonar.login>sqp_824e45138eba56c8767bd1bf53069e2a787f959c</sonar.login>-->
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.0.0-M5</version>
                    <executions>
                        <execution>
                            <id>verify</id>
                            <goals>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>


                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.maven-surefire-plugin}</version>

                    <configuration>
                        <systemPropertyVariables>

                            <browser>${browser}</browser>

                            <browserMode>${browserMode}</browserMode>

                            <cucumber.filter.tags>${cucumber.filter.tags}</cucumber.filter.tags>

                            <cucumber.features>${cucumber.features}</cucumber.features>

                            <credsFilePath>${credsFilePath}</credsFilePath>

                        </systemPropertyVariables>

                        <properties>


                            <property>
                                <name>dataproviderthreadcount</name>
                                <value>${threadCount}</value>
                            </property>
                        </properties>


                    </configuration>

                </plugin>

                <plugin>
                    <groupId>net.revelc.code.formatter</groupId>
                    <artifactId>formatter-maven-plugin</artifactId>
                    <version>${version.formatter-maven-plugin}</version>
                    <configuration>
                        <compilerSource>17</compilerSource>
                        <compilerCompliance>17</compilerCompliance>
                        <compilerTargetPlatform>17</compilerTargetPlatform>
                        <configFile>${project.basedir}/src/main/resources/eclipse/formatter.xml</configFile>
                        <lineEnding>LF</lineEnding>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>format</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>org.sonarsource.scanner.maven</groupId>-->
<!--                <artifactId>sonar-maven-plugin</artifactId>-->
<!--                <version>3.9.1.2184</version>-->
<!--            </plugin>-->

        </plugins>


    </build>

